OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-luna"
OPENAI_REASONING="none"

# Require interactive confirmation for plain-English deposits, withdrawals, and transfers.
USER_APPROVAL_REQUIRED="false" # aligns with project requirements but runs the AIs commands without user approval
# USER_APPROVAL_REQUIRED="true" # requires user approval for each command. Safer but diverges from project specification 

# safe: the app writes the reply from simulator facts after the model picks a wording.
# generated: the model writes the conversational reply. A failed reply call prints the simulator result.
SUMMARY_SETTING="generated" # aligns with project requirements but allows the AI to write whatever explanation it wants
# SUMMARY_SETTING="safe" # safer than allowing the AI to write whatever explanation it wants